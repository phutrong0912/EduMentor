# EduMentor AI - Backend Configuration
APP_NAME="EduMentor AI"
DEBUG=true

# Database (SQLite by default for local dev; use PostgreSQL in production/Docker)
# DATABASE_URL=postgresql+asyncpg://edumentor:edumentor@postgres:5432/edumentor
DATABASE_URL=sqlite+aiosqlite:///./edumentor.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false

# LLM Provider: "openai", "gemini", or "mock" (auto-detected if keys are provided)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Speech-to-Text Provider: "openai", "faster-whisper", or "mock"
STT_PROVIDER=auto
WHISPER_MODEL_SIZE=base

# Text-to-Speech Provider: "edge-tts", "openai", or "none"
TTS_PROVIDER=edge-tts
TTS_VOICE_VI=vi-VN-HoaiMyNeural
TTS_VOICE_EN=en-US-JennyNeural

# Security
SECRET_KEY=change-this-secret-key-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
